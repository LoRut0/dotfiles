#!/usr/bin/env python3
"""Create missing worktree slots and restore Arc mounts at startup."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path


SLOTS = ("first", "second", "third", "fourth")
RETRY_SECONDS = 15
MAX_SECONDS = 600
COMMAND_TIMEOUT = 90


def log(message: str) -> None:
    print(f"{datetime.now().astimezone().isoformat(timespec='seconds')} {message}", flush=True)


def run(command: list[str], *, timeout: float = COMMAND_TIMEOUT) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
            cwd=Path.home(),
        )
    except subprocess.TimeoutExpired:
        log(f"Timed out: {' '.join(command)}")
        return subprocess.CompletedProcess(command, 124, "", "command timed out")


def registry() -> dict[str, dict]:
    result = run(["arc", "mount", "--list", "--json"], timeout=30)
    if result.returncode:
        raise RuntimeError(f"arc mount --list failed ({result.returncode}): {result.stderr.strip()[-1000:]}")
    records = json.loads(result.stdout)
    if not isinstance(records, list):
        raise ValueError("arc mount --list did not return a JSON array")
    mounts = {}
    for record in records:
        path = os.path.normpath(record["mount"])
        if path in mounts:
            raise ValueError(f"duplicate Arc registration for {path}")
        mounts[path] = record
    return mounts


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("platform", choices=("mac", "linux-vm"))
    parser.add_argument("--slot", choices=SLOTS, help="restore one worktree slot")
    args = parser.parse_args()

    home = Path.home()
    path_entries = (str(home / ".local/bin"), "/usr/local/bin", "/opt/homebrew/bin", "/usr/bin", "/bin")
    os.environ["PATH"] = os.pathsep.join(path_entries + tuple(filter(None, os.environ.get("PATH", "").split(os.pathsep))))
    for program in ("arc", "ya"):
        if shutil.which(program) is None:
            log(f"Missing required command: {program}")
            return 1

    targets = []
    if args.slot:
        targets.append((home / "arcadia-wt" / args.slot, args.slot))
    else:
        if args.platform == "mac":
            targets.append((home / "arcadia", "arcadia"))
        targets.extend((home / "arcadia-wt" / slot, slot) for slot in SLOTS)
    blocked = set()
    deadline = time.monotonic() + MAX_SECONDS

    while time.monotonic() < deadline:
        try:
            mounts = registry()
        except (RuntimeError, ValueError, KeyError) as error:
            log(str(error))
            time.sleep(RETRY_SECONDS)
            continue

        pending = []
        for path, name in targets:
            if name in blocked:
                continue
            record = mounts.get(os.path.normpath(str(path)))
            if record is None:
                if name == "arcadia":
                    log(f"Primary Arc mount is not registered: {path}")
                    blocked.add(name)
                    continue
                if path.is_symlink() or (path.exists() and (not path.is_dir() or any(path.iterdir()))):
                    log(f"Cannot create worktree at non-empty or symbolic path: {path}")
                    blocked.add(name)
                    continue
                log(f"Creating {path} from trunk with a shared object store")
                result = run(
                    ["ya", "tool", "arc-wt", "add", name, "--base", "trunk", "--mode", "mount-shared", "--no-hooks"],
                    timeout=min(COMMAND_TIMEOUT, max(1, deadline - time.monotonic())),
                )
                if result.returncode:
                    log(f"Failed to create {path} ({result.returncode}): {result.stderr.strip()[-1000:]}")
                pending.append(name)
                continue
            if record.get("name") != name:
                log(f"Unexpected Arc mount name at {path}: {record.get('name')!r}")
                blocked.add(name)
                continue
            if record.get("status") == "mounted":
                continue
            if record.get("status") != "unmounted" or record.get("problems"):
                log(f"Cannot safely remount {path}: {record.get('status')}, problems={record.get('problems')}")
                pending.append(name)
                continue

            command = ["arc", "mount", str(path)] if name == "arcadia" else ["ya", "tool", "arc-wt", "remount", name]
            log(f"Restoring {path}")
            result = run(command, timeout=min(COMMAND_TIMEOUT, max(1, deadline - time.monotonic())))
            if result.returncode:
                log(f"Failed to restore {path} ({result.returncode}): {result.stderr.strip()[-1000:]}")
            pending.append(name)

        if not pending:
            break
        time.sleep(min(RETRY_SECONDS, max(0, deadline - time.monotonic())))

    try:
        mounts = registry()
    except (RuntimeError, ValueError, KeyError) as error:
        log(str(error))
        return 1
    unmounted = [str(path) for path, name in targets if name not in blocked and mounts.get(os.path.normpath(str(path)), {}).get("status") != "mounted"]
    if blocked or unmounted:
        log(f"Incomplete: blocked={sorted(blocked)}, unmounted={unmounted}")
        return 1
    log("All requested Arc mounts are active")
    return 0


if __name__ == "__main__":
    sys.exit(main())
